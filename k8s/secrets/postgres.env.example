# Copy to postgres.env and set a strong password (keep all three consistent).
#   cp k8s/secrets/postgres.env.example k8s/secrets/postgres.env
# postgres.env is gitignored; this .example file is committed.
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://chatbot:changeme_strong_password@postgres:5432/chatbot
SYNC_DATABASE_URL=postgresql://chatbot:changeme_strong_password@postgres:5432/chatbot
